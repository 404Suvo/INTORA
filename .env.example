# ====================================================================
# Intent-to-Commerce Environment Configuration (.env.example)
# NEVER commit your actual .env file or private keys.
# ====================================================================

# 1. Google Gemini API (Server-Side Only)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# 2. ScraperAPI (Server-Side Only - Real Amazon India Search & Pricing)
# Get an API key at https://www.scraperapi.com
# - Local Development: Add your key below in your local .env file.
# - Vercel Production: Add SCRAPERAPI_KEY in Vercel Project Settings > Environment Variables, then redeploy.
# - SECURITY: Never prefix with NEXT_PUBLIC_. Keep this key strictly server-side.
SCRAPERAPI_KEY=
SCRAPERAPI_TIMEOUT_MS=20000

# 2. Base Sepolia Blockchain (Testnet Only - Chain ID 84532)
BASE_SEPOLIA_RPC=https://sepolia.base.org

# 3. Contract Deployer Key (Testnet Only)
# Use a throwaway testnet wallet. NEVER use mainnet keys or real funds.
# Fund with free Base Sepolia ETH from faucets (e.g., https://faucets.chain.link/base-sepolia)
DEPLOYER_PRIVATE_KEY=0x_throwaway_testnet_private_key_here

# 4. Deployed ShoppingIntentRegistry Address
# Set automatically by `npm run deploy:base-sepolia` or paste manually
NEXT_PUBLIC_INTENT_REGISTRY_ADDRESS=0xb3bfe4b59fefb1fdac47f1185a09ebece05e961f

# 5. Optional Explorer Verification (Basescan)
#BASESCAN_API_KEY=

# 6. Optional Privacy Salt (default false)
NEXT_PUBLIC_ENABLE_SALT=false

# ====================================================================
# 7. x402 Payment Protocol Configuration (Base Sepolia - Testnet Only)
# ====================================================================
# Dedicated test agent wallet private key (Server-Side Only)
# NEVER commit your actual private key or fund with mainnet crypto.
# Get free Base Sepolia USDC from Circle faucet: https://faucet.circle.com/ (Select Base Sepolia)
X402_BUYER_PRIVATE_KEY=

# Seller receiving address (where x402 payment settles)
X402_SELLER_ADDRESS=0x1eC6F66Fe81A2F01Ee95F1D58FCea2522B9eC9d3

# Official x402 Facilitator URL (Testnet)
X402_FACILITATOR_URL=https://x402.org/facilitator

# Maximum allowed payment per request in USD (Default 0.05 USDC cap)
X402_MAX_PAYMENT_USD=0.05

# Base application URL (used for internal server-to-server x402 requests)
# Set to your Vercel deployment URL in production (e.g., https://your-project.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
